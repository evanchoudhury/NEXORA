<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding: 30px 0;
    }
    .metric-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .metric-val {
      font-size: 2rem;
      font-weight: 700;
      color: #38bdf8;
    }
    .metric-label {
      color: #94a3b8;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .table-dark-custom {
      background-color: #1e293b;
      color: #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .table-dark-custom th {
      background-color: #0f172a;
      color: #94a3b8;
      border-color: #334155;
    }
    .table-dark-custom td {
      border-color: #334155;
      vertical-align: middle;
    }
    .brand-title {
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #818cf8;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
    <div>
      <h2 class="brand-title mb-1">NEXORA Executive Analytics Report</h2>
      <div class="text-secondary small">Real-time PostgreSQL telemetry on InsForge</div>
    </div>
    <div class="text-end">
      <span class="badge bg-primary px-3 py-2">Generated: <%= new Date().toLocaleString('en-IN') %></span>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row">
    <div class="col-md-3 col-sm-6">
      <div class="metric-card">
        <div class="metric-label">Total Revenue</div>
        <div class="metric-val text-success">₹<%= Number(metrics.overview.totalRevenue).toLocaleString('en-IN') %></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="metric-card">
        <div class="metric-label">Total Orders</div>
        <div class="metric-val"><%= metrics.overview.totalOrders %></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="metric-card">
        <div class="metric-label">Registered Customers</div>
        <div class="metric-val"><%= metrics.overview.totalCustomers %></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="metric-card">
        <div class="metric-label">Low Stock Warnings</div>
        <div class="metric-val <%= metrics.overview.lowStockCount > 0 ? 'text-warning' : 'text-muted' %>">
          <%= metrics.overview.lowStockCount %>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Performance -->
  <div class="row">
    <div class="col-lg-6">
      <div class="metric-card">
        <h5 class="mb-3 text-white">Revenue by Category</h5>
        <div class="table-responsive">
          <table class="table table-dark-custom mb-0">
            <thead>
              <tr>
                <th>Category</th>
                <th>Units Sold</th>
                <th class="text-end">Revenue</th>
              </tr>
            </thead>
            <tbody>
              <% metrics.categorySales.forEach(function(cat) { %>
                <tr>
                  <td><%= cat.category_name %></td>
                  <td><%= cat.items_sold %></td>
                  <td class="text-end fw-bold text-info">₹<%= Number(cat.total_revenue).toLocaleString('en-IN') %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-lg-6">
      <div class="metric-card">
        <h5 class="mb-3 text-white">Critical Low Stock Alerts</h5>
        <div class="table-responsive">
          <table class="table table-dark-custom mb-0">
            <thead>
              <tr>
                <th>Product</th>
                <th>SKU</th>
                <th>Remaining Stock</th>
                <th>Threshold</th>
              </tr>
            </thead>
            <tbody>
              <% metrics.lowStockAlerts.forEach(function(item) { %>
                <tr>
                  <td><%= item.name %></td>
                  <td class="text-muted font-monospace small"><%= item.sku %></td>
                  <td><span class="badge bg-danger"><%= item.stock %> units</span></td>
                  <td class="text-muted"><%= item.low_stock_threshold %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="metric-card">
    <h5 class="mb-3 text-white">Recent Orders</h5>
    <div class="table-responsive">
      <table class="table table-dark-custom mb-0">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Total Amount</th>
            <th>Payment Method</th>
            <th>Payment Status</th>
            <th>Order Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% metrics.recentOrders.forEach(function(o) { %>
            <tr>
              <td class="fw-bold font-monospace text-primary"><%= o.order_number %></td>
              <td><%= o.customer_name %> (<%= o.customer_email %>)</td>
              <td class="fw-bold text-success">₹<%= Number(o.total_amount).toLocaleString('en-IN') %></td>
              <td><%= o.payment_method %></td>
              <td>
                <span class="badge <%= o.payment_status === 'PAID' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= o.payment_status %>
                </span>
              </td>
              <td><span class="badge bg-secondary"><%= o.order_status %></span></td>
              <td class="text-muted small"><%= new Date(o.created_at).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</body>
</html>
