<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Error - NEXORA' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      background-color: #0b0f19;
      color: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .error-box {
      max-width: 500px;
      padding: 40px;
      background: #1e293b;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }
  </style>
</head>
<body>
  <div class="error-box">
    <h1 class="display-4 fw-bold text-danger"><%= statusCode || 500 %></h1>
    <h4 class="mb-3"><%= message || 'An error occurred' %></h4>
    <p class="text-secondary small">Please return to the NEXORA storefront or contact support if the issue persists.</p>
    <a href="/" class="btn btn-primary mt-3">Return to Home</a>
  </div>
</body>
</html>
