<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
    }
    .invoice-card {
      max-width: 850px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.06);
      padding: 40px;
    }
    .brand-logo {
      font-weight: 800;
      font-size: 1.75rem;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .invoice-badge {
      padding: 6px 14px;
      font-weight: 600;
      border-radius: 20px;
      font-size: 0.85rem;
    }
    .table th {
      background-color: #f1f5f9;
      color: #475569;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
      border: none;
    }
    .table td {
      vertical-align: middle;
      border-color: #f1f5f9;
    }
    @media print {
      body { background: transparent; }
      .invoice-card { box-shadow: none; margin: 0; padding: 0; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>

<div class="container">
  <div class="invoice-card">
    <div class="d-flex justify-content-between align-items-center pb-4 border-bottom">
      <div>
        <div class="brand-logo">NEXORA</div>
        <div class="text-muted small">Shop Smarter. Experience More.</div>
        <div class="text-secondary small mt-1">support@nexora.com | www.nexora.com</div>
      </div>
      <div class="text-end">
        <h4 class="mb-1 text-uppercase fw-bold text-secondary">Tax Invoice</h4>
        <div class="fw-bold fs-5 text-primary">#<%= order.order_number %></div>
        <div class="text-muted small">Date: <%= new Date(order.created_at).toLocaleDateString('en-IN', { dateStyle: 'long' }) %></div>
        <div class="mt-2">
          <% if (order.payment_status === 'PAID') { %>
            <span class="badge bg-success invoice-badge">PAID</span>
          <% } else { %>
            <span class="badge bg-warning text-dark invoice-badge"><%= order.payment_status %></span>
          <% } %>
          <span class="badge bg-primary invoice-badge"><%= order.order_status %></span>
        </div>
      </div>
    </div>

    <div class="row my-4">
      <div class="col-sm-6">
        <h6 class="text-muted text-uppercase small fw-bold mb-2">Billed & Shipped To</h6>
        <div class="fw-bold"><%= order.user_name %></div>
        <div class="text-secondary small"><%= order.shipping_address.address_line1 %></div>
        <% if (order.shipping_address.address_line2) { %>
          <div class="text-secondary small"><%= order.shipping_address.address_line2 %></div>
        <% } %>
        <div class="text-secondary small">
          <%= order.shipping_address.city %>, <%= order.shipping_address.state %> - <%= order.shipping_address.postal_code %>
        </div>
        <div class="text-secondary small"><%= order.shipping_address.country %></div>
        <div class="text-secondary small">Phone: <%= order.shipping_address.phone %></div>
        <div class="text-secondary small">Email: <%= order.user_email %></div>
      </div>
      <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
        <h6 class="text-muted text-uppercase small fw-bold mb-2">Payment Details</h6>
        <div><span class="text-muted small">Payment Method: </span><span class="fw-semibold"><%= order.payment_method %></span></div>
        <% if (order.tracking_number) { %>
          <div><span class="text-muted small">Tracking Number: </span><span class="fw-semibold"><%= order.tracking_number %></span></div>
        <% } %>
        <% if (order.coupon_code) { %>
          <div><span class="text-muted small">Coupon Applied: </span><span class="badge bg-info text-dark"><%= order.coupon_code %></span></div>
        <% } %>
        <% if (order.blockchain_transaction) { %>
          <div class="mt-2 p-2 bg-light rounded text-start small border">
            <span class="text-muted d-block fw-bold">Web3 Proof of Payment:</span>
            <span class="text-truncate d-block font-monospace">Tx: <%= order.blockchain_transaction.transaction_hash %></span>
            <span>Network: <%= order.blockchain_transaction.network.toUpperCase() %> | Block: #<%= order.blockchain_transaction.block_number %></span>
          </div>
        <% } %>
      </div>
    </div>

    <div class="table-responsive my-4">
      <table class="table">
        <thead>
          <tr>
            <th>Item</th>
            <th>SKU</th>
            <th class="text-center">Quantity</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Total</th>
          </tr>
        </thead>
        <tbody>
          <% order.items.forEach(function(item) { %>
            <tr>
              <td>
                <div class="fw-semibold"><%= item.product_name %></div>
              </td>
              <td class="text-muted small font-monospace"><%= item.product_sku %></td>
              <td class="text-center"><%= item.quantity %></td>
              <td class="text-end">₹<%= Number(item.price).toLocaleString('en-IN') %></td>
              <td class="text-end fw-semibold">₹<%= Number(item.total).toLocaleString('en-IN') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="row justify-content-end">
      <div class="col-sm-6 col-md-5">
        <table class="table table-sm table-borderless">
          <tr>
            <td class="text-muted">Subtotal:</td>
            <td class="text-end">₹<%= Number(order.subtotal).toLocaleString('en-IN') %></td>
          </tr>
          <% if (order.discount_amount > 0) { %>
            <tr>
              <td class="text-success">Discount:</td>
              <td class="text-end text-success">-₹<%= Number(order.discount_amount).toLocaleString('en-IN') %></td>
            </tr>
          <% } %>
          <tr>
            <td class="text-muted">GST (18%):</td>
            <td class="text-end">₹<%= Number(order.tax_amount).toLocaleString('en-IN') %></td>
          </tr>
          <tr>
            <td class="text-muted">Shipping:</td>
            <td class="text-end"><%= order.shipping_amount > 0 ? `₹${Number(order.shipping_amount).toLocaleString('en-IN')}` : 'FREE' %></td>
          </tr>
          <tr class="border-top">
            <td class="fw-bold fs-5">Grand Total:</td>
            <td class="text-end fw-bold fs-5 text-primary">₹<%= Number(order.total_amount).toLocaleString('en-IN') %></td>
          </tr>
        </table>
      </div>
    </div>

    <div class="border-top pt-4 mt-4 text-center text-muted small">
      <p class="mb-1">Thank you for shopping with NEXORA! For any inquiries, please contact <strong>support@nexora.com</strong>.</p>
      <p class="mb-0 text-secondary" style="font-size: 0.75rem;">This is a computer-generated tax invoice and requires no physical signature.</p>
    </div>

    <div class="text-center mt-4 no-print">
      <button onclick="window.print()" class="btn btn-primary px-4 py-2">
        <i class="bi bi-printer"></i> Print Invoice
      </button>
    </div>
  </div>
</div>

</body>
</html>
