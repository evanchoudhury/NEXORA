# NEXORA Environment Configuration Template
PORT=5000
NODE_ENV=development

# InsForge Platform API & Anon Key
INSFORGE_URL=https://<appkey>.<region>.insforge.app
INSFORGE_ANON_KEY=anon_<your_anon_key>

# InsForge PostgreSQL Direct Connection
DATABASE_URL=postgresql://postgres:<password>@<appkey>.<region>.database.insforge.app:5432/insforge?sslmode=require

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Web3 & Blockchain (EVM Sepolia Testnet)
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
PAYMENT_RECEIVER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
ETH_PRICE_INR=280000

# Client Application URL
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
