{
  "name": "nexora",
  "version": "1.0.0",
  "description": "NEXORA — Shop Smarter. Experience More. Production Full-Stack E-Commerce Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mcp": "cd mcp-server && node server.js",
    "test:backend": "cd backend && npm test",
    "test:mcp": "cd mcp-server && npm test",
    "test": "npm run test:backend && npm run test:mcp",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "ecommerce",
    "insforge",
    "postgresql",
    "react",
    "express",
    "web3",
    "ethereum",
    "mcp"
  ],
  "author": "NEXORA Core Engineering",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
